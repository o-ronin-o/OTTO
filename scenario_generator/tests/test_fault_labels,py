# ----------------------------------------------------------------------
# End-to-end with the seed scenario
# ----------------------------------------------------------------------

def test_seed_scenario_produces_labels(loader):
    """Run the full pipeline on the seed scenario and verify labels."""
    from src.pipeline import Pipeline

    pipeline = Pipeline(CONFIG_DIR)
    result = pipeline.run(
        CONFIG_DIR / "scenarios" / "highway_brake_wear_gradual.yaml",
        output_dir=Path("data") / "fault_labels_test",
    )

    assert result.faults_path is not None
    assert result.labels_path is not None
    assert result.faults_path.exists()
    assert result.labels_path.exists()

    # faults.csv has one row per applied fault
    faults_df = pd.read_csv(result.faults_path)
    assert len(faults_df) == len(result.applied_faults)
    assert set(faults_df["fault_id"]) == {a.fault_id for a in result.applied_faults}

    # labels.csv has one row per frame
    frames_df = pd.read_csv(result.frames_path)
    labels_df = pd.read_csv(result.labels_path)
    assert len(labels_df) == len(frames_df)

    # Alignment
    assert (labels_df["timestamp_ms"].values == frames_df["timestamp_ms"].values).all()
    assert (labels_df["can_id"].values == frames_df["can_id"].values).all()

    # Some frames must be flagged as faulty
    assert (labels_df["is_fault"] == 1).any()

    # Some frames must be clean
    assert (labels_df["is_fault"] == 0).any()